NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
NEXT_PUBLIC_HEDERA_MAINNET_RPC_URL=
NEXT_PUBLIC_HEDERA_TESTNET_RPC_URL=

# Server-only provenance settings. Never expose operator keys through NEXT_PUBLIC_* variables.
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_TOPIC_ID=
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# Kubo RPC and gateway. The bundled Docker compose exposes both on localhost.
IPFS_API_URL=http://127.0.0.1:5001/api/v0
IPFS_GATEWAY_URL=http://127.0.0.1:8080

# Production safety. Local development may omit PROVENANCE_WRITE_TOKEN.
# In NODE_ENV=production the write endpoint is disabled until this is configured.
PROVENANCE_WRITE_TOKEN=

# External-call and backpressure limits.
PROVENANCE_EXTERNAL_TIMEOUT_MS=10000
PROVENANCE_MIRROR_MAX_PAGES=20
PROVENANCE_MAX_INFLIGHT_ANCHORS=2
