NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
NEXT_PUBLIC_HEDERA_MAINNET_RPC_URL=
NEXT_PUBLIC_HEDERA_TESTNET_RPC_URL=

# Server-only provenance settings. Never expose operator keys through NEXT_PUBLIC_* variables.
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_TOPIC_ID=
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# Kubo RPC endpoint used to add/pin evidence and localhost gateway used for verification.
IPFS_API_URL=http://127.0.0.1:5001/api/v0
IPFS_GATEWAY_URL=http://127.0.0.1:8080

# Required for write requests in production. Users enter this value in the demo UI;
# it is never bundled into NEXT_PUBLIC_* JavaScript.
PROVENANCE_WRITE_API_KEY=

# Bounded external I/O and write concurrency.
PROVENANCE_IPFS_TIMEOUT_MS=20000
PROVENANCE_GATEWAY_TIMEOUT_MS=15000
PROVENANCE_MIRROR_TIMEOUT_MS=10000
PROVENANCE_MIRROR_MAX_PAGES=10
PROVENANCE_MAX_CONCURRENT_WRITES=2
